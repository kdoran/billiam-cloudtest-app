---
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>Self-editing app</title>
		<style>
			:root { color-scheme: light dark; }
			body {
				font-family: system-ui, sans-serif;
				max-width: 40rem;
				margin: 4rem auto;
				padding: 0 1rem;
			}
			h1 { font-size: 1.4rem; }
			p.sub { color: #777; margin-top: -0.5rem; }
			textarea {
				width: 100%;
				min-height: 6rem;
				font: inherit;
				padding: 0.75rem;
				box-sizing: border-box;
			}
			button {
				margin-top: 0.75rem;
				padding: 0.6rem 1.2rem;
				font: inherit;
				cursor: pointer;
			}
			button:disabled { cursor: default; opacity: 0.6; }
			pre {
				background: color-mix(in srgb, currentColor 6%, transparent);
				padding: 0.75rem;
				overflow-x: auto;
				white-space: pre-wrap;
				word-break: break-word;
			}
			#status { color: #777; }
			#logs {
				max-height: 16rem;
				overflow-y: auto;
				font-size: 0.85em;
			}
			#logs[hidden] { display: none; }
			#error { color: #c0392b; white-space: pre-wrap; }
		</style>
	</head>
	<body>
		<h1>Commits to main now!</h1>
		<p class="sub">Describe a change. A coding agent will edit this app's own repo and hand back a live preview.</p>

		<form id="requestForm">
			<textarea id="task" placeholder="e.g. Add a dark mode toggle to the header" required></textarea>
			<button id="submitBtn" type="submit">Make the change</button>
		</form>

		<p id="status" hidden></p>

		<pre id="logs" hidden></pre>

		<p id="error" hidden></p>

		<script>
			// Events emitted by agent-worker's SSE stream (proxied through
			// /api/apply as-is). Plain hand-rolled SSE - what's actually being
			// streamed is a sandboxed shell subprocess's stdout, not model
			// tokens, so a token-streaming library (like the Vercel AI SDK)
			// doesn't fit here.
			type AgentEvent =
				| { type: 'status'; message: string }
				| { type: 'log'; stream: 'stdout' | 'stderr'; data: string }
				| { type: 'done'; logs: string; diff: string; appUrl: string }
				| { type: 'error'; message: string };

			const form = document.querySelector<HTMLFormElement>('#requestForm')!;
			const taskInput = document.querySelector<HTMLTextAreaElement>('#task')!;
			const submitBtn = document.querySelector<HTMLButtonElement>('#submitBtn')!;
			const statusEl = document.querySelector<HTMLParagraphElement>('#status')!;
			const logsEl = document.querySelector<HTMLPreElement>('#logs')!;
			const errorEl = document.querySelector<HTMLParagraphElement>('#error')!;

			// Parses "data: {...json...}\n\n" frames out of a decoded SSE text
			// stream and yields the parsed events as they arrive.
			async function* readEvents(body: ReadableStream<Uint8Array>): AsyncGenerator<AgentEvent> {
				// TS's DOM lib types TextDecoderStream's writable side as
				// WritableStream<BufferSource>, which pipeThrough's stricter
				// ReadableStream<Uint8Array> signature rejects - a lib typing
				// quirk, not a real incompatibility.
				const reader = (body as ReadableStream<any>).pipeThrough(new TextDecoderStream()).getReader();
				let buffer = '';
				for (;;) {
					const { value, done } = await reader.read();
					if (done) return;
					buffer += value;
					let sepIndex: number;
					while ((sepIndex = buffer.indexOf('\n\n')) !== -1) {
						const frame = buffer.slice(0, sepIndex);
						buffer = buffer.slice(sepIndex + 2);
						const dataLine = frame.split('\n').find((line) => line.startsWith('data:'));
						if (!dataLine) continue;
						const payload = dataLine.slice(5).trim();
						if (payload === '[DONE]') continue; // stream-end sentinel, not an event
						yield JSON.parse(payload) as AgentEvent;
					}
				}
			}

			form.addEventListener('submit', async (e) => {
				e.preventDefault();
				const task = taskInput.value.trim();
				if (!task) return;

				submitBtn.disabled = true;
				errorEl.hidden = true;
				logsEl.hidden = false;
				logsEl.textContent = '';
				statusEl.hidden = false;
				statusEl.textContent = 'Starting…';

				try {
					const res = await fetch('/api/apply', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ task }),
					});
					if (!res.ok || !res.body) {
						let message = `Request failed (${res.status})`;
						try {
							const data = (await res.json()) as { error?: string };
							message = data.error ?? message;
						} catch {
							/* body wasn't JSON - keep the generic message */
						}
						throw new Error(message);
					}

					let done = false;
					for await (const event of readEvents(res.body)) {
						if (event.type === 'status') {
							statusEl.textContent = event.message;
						} else if (event.type === 'log') {
							logsEl.textContent += event.data;
							logsEl.scrollTop = logsEl.scrollHeight;
						} else if (event.type === 'done') {
							done = true;
							statusEl.textContent = 'Live - reloading…';
						} else if (event.type === 'error') {
							throw new Error(event.message);
						}
					}
					// The change is already committed to main and deployed live -
					// this *is* that new version, so just reload into it.
					if (done) window.location.reload();
				} catch (err) {
					errorEl.hidden = false;
					errorEl.textContent = err instanceof Error ? err.message : String(err);
				} finally {
					statusEl.hidden = true;
					submitBtn.disabled = false;
				}
			});
		</script>
	</body>
</html>
