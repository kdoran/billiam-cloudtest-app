{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"compatibility_date": "2026-08-31",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"name": "billiam-cloudtest-app",
	"main": "@astrojs/cloudflare/entrypoints/server",
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"AGENT_WORKER_URL": "https://billiam-cloudtest-agent-worker.kevin-ddf.workers.dev/",
		"APP_REPO_URL": "https://github.com/kdoran/billiam-cloudtest-app.git"
	}
}